rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{userId} {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      function valid() {
        return request.resource.data.keys().hasOnly(['revision', 'payload', 'updatedAt'])
          && request.resource.data.revision is int
          && request.resource.data.payload is string
          && request.resource.data.payload.size() > 0
          && request.resource.data.payload.size() <= 250000
          && request.resource.data.updatedAt == request.time;
      }
      allow get: if owner();
      allow list: if false;
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid() && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if owner();
    }
  }
}
