# Configuración pública de la aplicación web de Firebase. Nunca usar claves privadas.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Solo para pruebas locales con el proyecto demo-luciernagas:
# VITE_FIREBASE_EMULATORS=true
# false para validar el modo local sin conectar con Firebase:
# VITE_FIREBASE_ENABLED=false
